(define show (lambda (x) (write x) (newline)))
(show (let ((a 1) (b 2)) (+ a b)))
(show (let ((x 1)) (let ((x 2)) x)))
(show (let ((x 10)) (set! x (+ x 1)) x))
(show (let () 42))
(show (let ((x 1) (y 2)) (let ((x y) (y x)) (list x y))))
(show (let* ((x 1) (y (+ x 1))) y))
(show (let* ((x 1) (x (+ x 1)) (x (+ x 1))) x))
(show (letrec ((f (lambda (n) (if (= n 0) 1 (* n (f (- n 1))))))) (f 5)))
(show (letrec ((even? (lambda (n) (if (= n 0) #t (odd? (- n 1)))))
               (odd? (lambda (n) (if (= n 0) #f (even? (- n 1))))))
        (even? 10)))
(show (and))
(show (or))
(show (and 1 2 3))
(show (and 1 #f 3))
(show (or #f #f 5))
(show (or 1 2))
(show (and #t 'hello))
(show (or '() 'a))
(show (and (= 1 1) (= 2 2)))
(define hits 0)
(define bump (lambda () (set! hits (+ hits 1)) #f))
(show (and (bump) (bump)))
(show hits)
(show (or (bump) #t))
(show hits)
