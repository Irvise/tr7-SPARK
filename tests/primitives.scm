(define show (lambda (x) (write x) (newline)))
(show (- 10 3 2))
(show (* 2 3 4))
(show (< 1 2 3))
(show (>= 3 3 2))
(show (null? '()))
(show (pair? '(1)))
(show (not #f))
(show (not 0))
(show (car '(1 2)))
(show (cdr '(1 2)))
(show "hi")
(show #\A)
(show 'sym)
(show (eq? '() '()))
(show (cons 'a 'b))
