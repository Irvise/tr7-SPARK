(define show (lambda (x) (write x) (newline)))
(show (do ((i 3 (- i 1)))
          ((= i 0) 'done)
          (write i)
          (newline)))
(show (do ((i 1 (+ i 1)) (sum 0 (+ sum i)))
          ((> i 5) sum)))
(show (do ((i 1 j) (j 2 i) (n 0 (+ n 1)))
          ((= n 4) (list i j))))
(show (do ((x 5) (y 0 (+ y 1)))
          ((> y 3) (list x y))))
(show (let ((acc '()))
        (do ((i 1 (+ i 1)))
            ((> i 3) (reverse acc))
            (set! acc (cons i acc)))))
(show (do ((i 0 (+ i 1))) ((> i 10))))
(show (let ((n 7))
        (do ((x n)) ((> x 100) x) (set! x (* x 2)))))
(show (do () (#t)))
(show (do ((x 1)) ((> x 3) x) (set! x (+ x 1))))
