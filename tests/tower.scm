(define show (lambda (x) (write x) (newline)))
;; bignums: literals, promotion, arithmetic, reader/writer
(show 123456789012345678901234567890)
(show -123456789012345678901234567890)
(show (+ 2147483647 1))
(show (* 12345678901234567890 12345678901234567890))
(show (- 0 999999999999999999999999999999))
(show (abs -2147483648))
(show (even? 123456789012345678901234567890))
(show (odd? 99999999999999999999))
(show (expt 2 100))
(show (number->string 12345678901234567890))
(show (string->number "123456789012345678901234567890"))
;; exact rationals: normalization, arithmetic, comparison
(show 2/4)
(show -3/6)
(show 4/2)
(show 0/5)
(show (+ 1/2 1/3))
(show (- 1/2 1/3))
(show (* 2/3 3/4))
(show (/ 2/3 4/9))
(show (/ 1 3))
(show (+ 1/2 1.0))
(show (* 2/3 3))
(show (= 1/2 2/4))
(show (eqv? 1/2 2/4))
(show (eqv? 1/2 0.5))
(show (< 1/3 1/2 2/3))
(show (exact->inexact 1/4))
;; predicates
(show (number? 1/2))
(show (integer? 4/2))
(show (integer? 3/2))
(show (rational? 1.5))
(show (real? 1/2))
(show (complex? 1/2))
(show (exact? 1/2))
(show (inexact? 2.0))
(show (zero? 0/7))
(show (positive? 1/2))
(show (negative? -1/2))
(show (abs -7/3))
(show (max 1/2 2/3 3/4))
(show (min 1/2 2/3 3/4))
;; exact integer division and negative powers
(show (quotient 100000000000000000000 7))
(show (remainder 100000000000000000000 7))
(show (modulo -100000000000000000000 7))
(show (expt 2 -3))
(show (string->number "3/4"))
