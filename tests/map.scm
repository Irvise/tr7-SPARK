(define show (lambda (x) (write x) (newline)))
(define (double x) (* x 2))
(show (map double '(1 2 3)))
(show (map (lambda (x) (* x x)) '(1 2 3 4)))
(show (map car '((a b) (c d))))
(show (map cdr '((a b) (c d))))
(show (map + '(1 2) '(10 20)))
(show (map list '(1 2) '(10 20)))
(show (map double '()))
(define hits 0)
(for-each (lambda (x) (set! hits (+ hits x))) '(1 2 3))
(show hits)
(for-each (lambda (x) (write x) (newline)) '(1 2 3))
(show (map + '(1 2 3) '(10 20 30) '(100 200 300)))
(map double)
