(define show (lambda (x) (write x) (newline)))
(show (cond ((= 1 2) 'no) ((= 2 2) 'yes) (else 'maybe)))
(show (cond ((= 1 2) 'no) (else 'maybe)))
(show (cond ((and #t 7))))
(show (cond (#f 'a) (#t 'b)))
(show (cond (5 => (lambda (n) (* n 10)))))
(show (cond (#f => car) (3 => (lambda (n) (+ n 1)))))
(show (when #t 42))
(show (when #t 1 2 3))
(show (unless #f 43))
(show (unless #f (define z 5) z))
(show (when #t (let ((a 3)) (* a a))))
(define count-down (lambda (n) (if (= n 0) 'done (unless #f (count-down (- n 1))))))
(show (count-down 3))
(show (cond (#t (define w 6) w)))
