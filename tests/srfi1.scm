(import (srfi 1) (srfi 9))
(define show (lambda (x) (write x) (newline)))
(show (filter odd? '(1 2 3 4 5)))
(show (fold + 0 '(1 2 3 4)))
(show (fold-right cons '() '(1 2 3)))
(show (any even? '(1 2 3)))
(show (every odd? '(1 3 5)))
(show (find even? '(1 2 3)))
(show (take '(1 2 3 4) 2))
(show (drop '(1 2 3 4) 2))
(show (iota 5))
(show (iota 3 10 2))
(show (zip '(1 2) '(a b)))
(show (concatenate '((1 2) (3 4))))
(show (last '(1 2 3)))
(show (delete 2 '(1 2 3 2)))
(show (delete-duplicates '(1 2 1 3 2)))
