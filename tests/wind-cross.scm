(define show (lambda (x) (write x) (newline)))
(define k #f)
(define log '())
(define (note x) (set! log (cons x log)))
(dynamic-wind (lambda () (note 'a-in))
              (lambda () (call/cc (lambda (c) (set! k c))) (note 'a-body))
              (lambda () (note 'a-out)))
(dynamic-wind (lambda () (note 'b-in))
              (lambda () (k 'go))
              (lambda () (note 'b-out)))
(show (reverse log))
