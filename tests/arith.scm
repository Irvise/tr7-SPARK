(define show (lambda (x) (write x) (newline)))
;;  abs: exactness follows the argument.
(show (abs -5))
(show (abs -3.0))
(show (abs 2.5))
(show (abs -2.5))
;;  min/max: one inexact argument makes the result inexact.
(show (min 3 1 2))
(show (max 3 1 2))
(show (min 1 2.0))
(show (min 1.5 2))
(show (max 1 2.0))
(show (max 1.5 2))
(show (min -1.0))
(show (max 2.5))
(show (exact? (max 1 2)))
(show (exact? (max 1 2.0)))
;;  expt: mixed operands give inexact results.
(show (expt 2 10))
(show (expt 2 3.0))
(show (expt 2.0 3))
(show (expt 2.0 -2))
(show (expt 2 0.0))
(show (expt 2.0 0))
(show (expt -2.0 3))
(show (expt -1.0 63))
(show (expt 2 60.0))
(show (expt 2 0.5))
(show (expt 10 2.5))
;;  quotient/remainder/modulo accept inexact integers.
(show (quotient 7.0 2))
(show (quotient 7 2.0))
(show (quotient -7.0 2))
(show (quotient 7.5 2.0))
(show (remainder -7.0 2))
(show (remainder 7 -2.0))
(show (remainder 7.0 -2))
(show (modulo 7.0 -3))
(show (modulo -7.0 3))
(show (modulo -7.0 -3))
(show (quotient -2147483648.0 1))
;;  still exact and guarded on exact operands
(show (quotient -2147483648 1))
(show (quotient 2147483647.0 1.0))
(quotient -2147483648 -1)
