(define show (lambda (x) (write x) (newline)))
(show (length '(1 2 3)))
(show (length '()))
(show (append '(1 2) '(3 4)))
(show (append))
(show (append '(1) '() '(2)))
(show (reverse '(1 2 3)))
(show (reverse '()))
(show (list-ref '(a b c) 0))
(show (list-ref '(a b c) 2))
(define alist (list (cons 'one 1) (cons 'two 2)))
(show (assq 'two alist))
(show (assq 'three alist))
(show (memq 'b '(a b c)))
(show (memq 'z '(a b c)))
(show (append '(1 2) '(3)))
(show (length (append '(1 2) '(3 4 5))))
