(import (srfi 1))
(define show (lambda (x) (write x) (newline)))
;;  Immediates: equal? is eqv? on leaves.
(show (equal? 1 1))
(show (equal? 1 1.0))
(show (equal? 1.0 1.0))
(show (equal? #\a #\a))
(show (equal? #\a #\b))
(show (equal? 'foo 'foo))
(show (equal? 'foo 'bar))
(show (equal? #t #t))
(show (equal? #t #f))
(show (equal? '() '()))
;;  Strings, bytevectors and symbols by content.
(show (equal? "abc" "abc"))
(show (equal? "abc" "abd"))
(show (equal? "ab" "abc"))
(show (equal? (string->symbol "x") 'x))
(show (equal? #u8(1 2) #u8(1 2)))
(show (equal? #u8(1 2) #u8(1 3)))
(show (equal? #u8(1 2) #u8(1 2 3)))
;;  Pairs, vectors, nesting.
(show (equal? '(1 2 3) '(1 2 3)))
(show (equal? '(1 2 3) '(1 2 4)))
(show (equal? '(1 2 (3 4)) '(1 2 (3 4))))
(show (equal? '(1 2 (3 4)) '(1 2 (3 5))))
(show (equal? '(1 2 3) '(1 2 3 4)))
(show (equal? #(1 2 3) #(1 2 3)))
(show (equal? #(1 2 3) #(1 2 4)))
(show (equal? #(1 2) '(1 2)))
(show (equal? "a" #\a))
(show (equal? (cons 1 2) (cons 1 2)))
(show (equal? (cons 1 2) (cons 1 3)))
;;  Shared structure still answers by content.
(define shared '(1 2 3))
(show (equal? (list shared 4) (list shared 4)))
;;  Rings built with set-cdr! must terminate.
(define r1 (list 1 2))
(set-cdr! (cdr r1) r1)
(show (equal? r1 r1))
(define r2 (list 1 2))
(set-cdr! (cdr r2) r2)
(show (equal? r1 r2))
(define r3 (list 1 3))
(set-cdr! (cdr r3) r3)
(show (equal? r1 r3))
(define s1 (list 'a))
(set-cdr! s1 s1)
(define s2 (list 'a))
(set-cdr! s2 s2)
(show (equal? s1 s2))
(show (equal? r1 '(1 2 1 2)))
(show (equal? '(1 2) r1))
;;  Rings through the car as well.
(define c1 (cons 1 '()))
(set-car! c1 c1)
(show (equal? c1 c1))
(define c2 (cons 1 '()))
(set-car! c2 c2)
(show (equal? c1 c2))
;;  member and assoc use equal?.
(show (member 2 '(1 2 3)))
(show (member 5 '(1 2 3)))
(show (member '(1 2) '((1 2) (3))))
(show (member 2 '()))
(show (assoc 2 '((1 a) (2 b))))
(show (assoc '(1 2) '(((1 2) x) ((3) y))))
(show (assoc 5 '((1 a))))
;;  SRFI-1 delete/delete-duplicates now compare with equal?.
(show (delete '(1 2) '((1 2) (3) (1 2))))
(show (delete 2 '(1 2 3 2)))
(show (delete-duplicates '((1 2) (3) (1 2) (3))))
;;  Deep lists: two independently built 1,000-element lists (well past the
;;  old 1,024 cap; both fit the 4,096-cell arena together with the prelude,
;;  and the comparison itself allocates nothing).
(define (build n) (let loop ((i 0) (acc '())) (if (= i n) acc (loop (+ i 1) (cons i acc)))))
(show (equal? (build 1000) (build 1000)))
(show (equal? (build 1000) (build 999)))
