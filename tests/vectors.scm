(define show (lambda (x) (write x) (newline)))
(show (vector? #(1 2 3)))
(show (vector? 5))
(show (vector-length #(1 2 3)))
(show (vector-length #()))
(show (vector-ref #(10 20 30) 0))
(show (vector-ref #(10 20 30) 2))
(show (vector 1 2))
(show (vector))
(show (let ((v (vector 7 8))) (begin (vector-set! v 0 99) v)))
(show (vector-ref (vector "a" 'b) 1))
(show #(#(1 2) 3))
(show '#((1 2) 3))
(show (vector-length (vector 1 2 3 4)))
