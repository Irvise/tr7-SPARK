(define show (lambda (x) (write x) (newline)))
(define log '())
(define k #f)
(define (note x) (set! log (cons x log)))
(dynamic-wind (lambda () (note 'in))
              (lambda () (call/cc (lambda (c) (set! k c))) (note 'body))
              (lambda () (note 'out)))
(if (< (length log) 4) (k 'again))
(show (reverse log))
