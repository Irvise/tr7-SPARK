(define show (lambda (x) (write x) (newline)))

(show (boolean? #t))
(show (boolean? 'a))
(show (symbol? 'a))
(show (symbol? "a"))
(show (char? #\a))
(show (char? 1))
(show (number? 1))
(show (number? 1.5))
(show (number? 'a))
(show (procedure? car))
(show (procedure? (lambda (x) x)))
(show (procedure? 1))

(define p (cons 1 2))
(set-car! p 3)
(show p)
(set-cdr! p 4)
(show p)

(show (caar '((1 2) 3)))
(show (cadr '(1 2 3)))
(show (cdar '((1 2) 3)))
(show (cddr '(1 2 3)))

(show (symbol->string 'hello))
(show (string->symbol "hello"))
(show (eq? 'abc (string->symbol "abc")))

(show (char->integer #\A))
(show (integer->char 65))
(show (char->integer (integer->char 955)))
(show (integer->char 955))
