(define show (lambda (x) (write x) (newline)))

(show (boolean? #t))
(show (boolean? 'a))
(show (symbol? 'a))
(show (symbol? "a"))
(show (char? #\a))
(show (char? 1))
(show (number? 1))
(show (number? 1.5))
(show (number? 'a))
(show (procedure? car))
(show (procedure? (lambda (x) x)))
(show (procedure? 1))

(define p (cons 1 2))
(set-car! p 3)
(show p)
(set-cdr! p 4)
(show p)

(show (caar '((1 2) 3)))
(show (cadr '(1 2 3)))
(show (cdar '((1 2) 3)))
(show (cddr '(1 2 3)))

(show (symbol->string 'hello))
(show (string->symbol "hello"))
(show (eq? 'abc (string->symbol "abc")))

(show (char->integer #\A))
(show (integer->char 65))
(show (char->integer (integer->char 955)))
(show (integer->char 955))

(define z 42)
(show (eval '(+ 1 2) (interaction-environment)))
(show (eval 'z (interaction-environment)))
(show (eval '(let ((y 2)) (* y 5)) (interaction-environment)))
(show (eval (list '+ 2 3) (interaction-environment)))

(show (list->vector '(1 2 3)))
(show (vector->list (vector 1 2 3)))
(show (list->string (list #\a #\b #\c)))
(show (string->list "abc"))
(show (string-copy "hello"))
(show (number->string 42))
(show (number->string 1.5))
(show (string->number "42"))
(show (string->number "1.5"))
(show (string->number "abc"))
(show (string->number "12x"))
(show (exact? 1))
(show (exact? 1.0))
(show (inexact? 1.0))
(show (zero? 0))
(show (zero? 1.5))
(show (positive? -1))
(show (negative? -1))
(show (odd? 3))
(show (even? 3))
(show (memv 2 '(1 2 3)))
(show (assv 2 '((1 . a) (2 . b))))

(show (char<? #\a #\b #\c))
(show (char=? #\a #\a))
(show (string<? "abc" "abd"))
(show (string>=? "b" "b"))
(show (make-string 3 #\x))
(show (make-string 2))
(define s (make-string 3 #\a))
(string-set! s 1 #\z)
(show s)
(show (make-vector 3 'x))
(define v (make-vector 3 0))
(vector-fill! v 7)
(show v)
(show (list-tail '(a b c d) 2))
(show (list-copy '(1 2 3)))
(show (last-pair '(1 2 3)))
(show (eqv? 'a 'a))
(show (eqv? 1 1.0))
(show (boolean=? #t #t #f))
(show (symbol=? 'a 'a))
