(define show (lambda (x) (write x) (newline)))
(define log '())
(define (note x) (set! log (cons x log)))
(dynamic-wind (lambda () (note 'in))
              (lambda () (note 'thunk))
              (lambda () (note 'out)))
(show (reverse log))
(show (dynamic-wind (lambda () 1) (lambda () 3) (lambda () 2)))
(define esc #f)
(show (call/cc (lambda (k) (set! esc k)
                 (dynamic-wind (lambda () (note 'in2))
                               (lambda () (esc 'escaped))
                               (lambda () (note 'out2))))))
(show (reverse log))
(define deep #f)
(show (call/cc (lambda (k) (set! deep k)
                 (dynamic-wind (lambda () (note 'a))
                               (lambda () (dynamic-wind (lambda () (note 'b))
                                                        (lambda () (deep 'deep))
                                                        (lambda () (note 'B))))
                               (lambda () (note 'A))))))
(show (reverse log))
(define seq '())
(define (mark x) (set! seq (cons x seq)))
(dynamic-wind (begin (mark 'e1) (lambda () (mark 'c1)))
              (begin (mark 'e2) (lambda () (mark 'c2)))
              (begin (mark 'e3) (lambda () (mark 'c3))))
(show (reverse seq))
(show (dynamic-wind (lambda () 'x) (lambda () 42) (begin (set! seq (cons 'ev seq)) (lambda () 'y))))
(show (reverse seq))
