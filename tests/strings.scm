(define show (lambda (x) (write x) (newline)))
(show (string? "abc"))
(show (string? 'abc))
(show (string-length "hello"))
(show (string-ref "hello" 1))
(show (string-ref "hello" 4))
(show (substring "hello" 1 3))
(show (substring "hello" 0 0))
(show (substring "hello" 2 5))
(show (string-append "ab" "cd"))
(show (string-append "" "xy"))
(show (string=? "abc" "abc"))
(show (string=? "abc" "abd"))
(show (string=? "abc" "ab"))
(show (string-append "1234" "5678"))
(show (string-length (string-append "abc" "de")))
(show #\x41)
(show #\x1234)
(show "hi")
