(define show (lambda (x) (write x) (newline)))
(show (call-with-values (lambda () 5) (lambda (x) x)))
(show (call-with-values (lambda () (values 1 2)) (lambda (a b) (+ a b))))
(show (call-with-values (lambda () (values)) (lambda () 'none)))
(show (call-with-values (lambda () (values 1)) (lambda (x) x)))
(show (call-with-values (lambda () (values 1 2 3)) list))
(define (swap a b) (values b a))
(show (call-with-values (lambda () (swap 1 2)) (lambda (x y) (list x y))))
(show (call-with-values (lambda () (values 'a 'b)) (lambda args args)))
