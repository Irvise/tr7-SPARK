(define show (lambda (x) (write x) (newline)))
(show (bytevector? (bytevector 1 2 3)))
(show (bytevector? 42))
(show (bytevector-length (bytevector 1 2 3)))
(show (bytevector-u8-ref (bytevector 10 20 30) 1))
(show (bytevector-u8-ref (bytevector 10 20 30) 2))
(show (let ((b (bytevector 1 2))) (begin (bytevector-u8-set! b 0 99) b)))
(show (bytevector))
(show (bytevector 255 0 128))
(show (bytevector-length #u8(7 8 9)))
(show (bytevector-u8-ref #u8(7 8 9) 0))
(show (bytevector? #u8(1)))
(show (bytevector-u8-set! #u8(1 2) 0 7))
