(define show (lambda (x) (write x) (newline)))
(show (call/cc (lambda (k) 42)))
(show (call/cc (lambda (k) (k 'escaped))))
(show (+ 1 (call/cc (lambda (k) (k 10)))))
(show (call/cc (lambda (k) (begin (write 'side) (newline) 'value))))
(define (find lst)
  (call/cc (lambda (return)
    (for-each (lambda (x) (if (= x 3) (return x) 'ok)) lst)
    'none)))
(show (find (list 1 2 3 4)))
(show (find (list 1 2)))
(show (call/cc (lambda (k) (if #f (k 'never)) 'after)))
(show ((call/cc (lambda (k) (lambda (x) (+ x 1)))) 41))
