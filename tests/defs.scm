(define show (lambda (x) (write x) (newline)))
(define (double x) (* x 2))
(show (double 21))
(define (count-down n) (if (= n 0) 'done (count-down (- n 1))))
(show (count-down 5))
(define (sum-all xs) (if (null? xs) 0 (+ (car xs) (sum-all (cdr xs)))))
(show (sum-all (list 1 2 3 4)))
(define (first-of . xs) (if (null? xs) 'none (car xs)))
(show (first-of))
(show (first-of 7 8))
(show ((lambda (a . rest) rest) 1 2 3))
(show ((lambda (a . rest) a) 1 2 3))
(define (no-args) 5)
(show (no-args))
(show (double 1 2))
