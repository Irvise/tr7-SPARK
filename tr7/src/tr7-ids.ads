--  Primitive procedure identifiers.
--
--  Keeping these in a standalone package avoids a dependency cycle between
--  the cell store and the primitive implementations.

package Tr7.Ids with
   SPARK_Mode => On
is

   type Primitive_Id is
     (P_None,
      P_Add,
      P_Sub,
      P_Mul,
      P_Num_Equal,
      P_Less,
      P_Greater,
      P_Less_Equal,
      P_Greater_Equal,
      P_Cons,
      P_Car,
      P_Cdr,
      P_List,
      P_Null_P,
      P_Pair_P,
      P_Eq_P,
      P_Not,
      P_Display,
      P_Newline,
      P_Write,
      P_Free_Cells,
      P_String_P,
      P_String_Length,
      P_String_Ref,
      P_String_Append,
      P_Substring,
      P_String_Equal,
      P_Vector_P,
      P_Vector_Length,
      P_Vector_Ref,
      P_Vector_Set,
      P_Vector,
      P_Bytevector_P,
      P_Bytevector_Length,
      P_Bytevector_U8_Ref,
      P_Bytevector_U8_Set,
      P_Bytevector,
      P_Length,
      P_Append,
      P_Reverse,
      P_List_Ref,
      P_Assq,
      P_Memq,
      P_Abs,
      P_Min,
      P_Max,
      P_Quotient,
      P_Remainder,
      P_Modulo,
      P_Expt,
      P_Sqrt,
      P_Exact_To_Inexact,
      P_Open_Input_String,
      P_Open_Output_String,
      P_Get_Output_String,
      P_Read,
      P_Read_Char,
      P_Peek_Char,
      P_Char_Ready,
      P_Port_P,
      P_Eof_Object_P,
      P_Div,
      P_Error);

end Tr7.Ids;
