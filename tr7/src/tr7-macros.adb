with Interfaces; use Interfaces;
with Tr7.Cells; use Tr7.Cells;
with Tr7.Config; use Tr7.Config;
with Tr7.Pairs; use Tr7.Pairs;

package body Tr7.Macros with
   SPARK_Mode => On
is

   --  Enough for every list level and every rule in a practical macro; a
   --  malformed or unsupported pattern runs out of fuel and simply fails to
   --  match (the caller reports an error rather than looping).
   Macro_Fuel : constant := 8 * Max_List_Length;

   --  Nested ellipses are represented by a path of indices: the first
   --  enclosing ellipsis contributes Path (1), the next one Path (2), and so
   --  on.  The bound is far above any practical template.
   Max_Ellipsis_Depth : constant := 16;
   type Path_Array is array (1 .. Max_Ellipsis_Depth) of Natural;

   --  Fresh identifiers generated by one expansion.  The counter is local to
   --  Expand and starts at zero, so the names are stable and readable; the
   --  generator skips a name that is already interned, which keeps nested or
   --  successive expansions from colliding.
   Max_Fresh : constant := 1_000_000_000;

   function Is_Symbol_Named
     (H : Heap_Type; V : Value; Name : String) return Boolean
     with Pre => H.Ready
   is
      C : Cell;
      Good : Boolean;
   begin
      if not Is_Handle (V) then
         return False;
      end if;
      Fetch (H, To_Handle (V), C, Good);
      return Good
        and then C.Kind = Cell_Symbol
        and then C.Name_Len = Name'Length
        and then C.Name (1 .. C.Name_Len) = Name;
   end Is_Symbol_Named;

   function Is_Ellipsis (H : Heap_Type; V : Value) return Boolean is
     (Is_Symbol_Named (H, V, "..."))
     with Pre => H.Ready;

   --  Membership in the literals list.
   function Is_Literal
     (H : Heap_Type; Sym, Lits : Value) return Boolean
     with Pre => H.Ready
   is
      Cur  : Value := Lits;
      Left : Natural := Max_List_Length + 1;
      C    : Cell;
      Good : Boolean;
   begin
      while not Is_Nil (Cur) and then Left > 0 loop
         pragma Loop_Invariant (H.Ready);
         pragma Loop_Variant (Decreases => Left);
         if not Is_Handle (Cur) then
            return False;
         end if;
         Fetch (H, To_Handle (Cur), C, Good);
         if not Good or else C.Kind /= Cell_Pair then
            return False;
         end if;
         if Same_Value (C.Car, Sym) then
            return True;
         end if;
         Cur := C.Cdr;
         Left := Left - 1;
      end loop;
      return False;
   end Is_Literal;

   --  Membership in an association list whose elements are (key . value).
   --  Used for pattern bindings and for the hygiene rename environment.
   function Member_Binding
     (H : Heap_Type; Bindings, Key : Value) return Boolean
     with Pre => H.Ready
   is
      Cur  : Value := Bindings;
      Left : Natural := Max_List_Length + 1;
      C    : Cell;
      B    : Cell;
      Good : Boolean;
   begin
      while not Is_Nil (Cur) and then Left > 0 loop
         pragma Loop_Invariant (H.Ready);
         pragma Loop_Variant (Decreases => Left);
         if not Is_Handle (Cur) then
            return False;
         end if;
         Fetch (H, To_Handle (Cur), C, Good);
         if not Good or else C.Kind /= Cell_Pair then
            return False;
         end if;
         if Is_Handle (C.Car) then
            Fetch (H, To_Handle (C.Car), B, Good);
            if Good and then B.Kind = Cell_Pair
              and then Same_Value (B.Car, Key)
            then
               return True;
            end if;
         end if;
         Cur := C.Cdr;
         Left := Left - 1;
      end loop;
      return False;
   end Member_Binding;

   --  Look up a (key . value) association built by Bind / Rep_Add.  The list
   --  may contain shadowed duplicates; the newest entry is at the front.
   procedure Lookup_Binding
     (H        : Heap_Type;
      Bindings : Value;
      Key      : Value;
      Val      : out Value;
      Found    : out Boolean;
      Ok       : out Boolean)
     with Pre => H.Ready
   is
      Cur  : Value := Bindings;
      Left : Natural := Max_List_Length + 1;
      C    : Cell;
      B    : Cell;
      Good : Boolean;
   begin
      Val := Nil_Value;
      Found := False;
      Ok := True;
      while not Is_Nil (Cur) and then Left > 0 loop
         pragma Loop_Invariant (H.Ready);
         pragma Loop_Variant (Decreases => Left);
         if not Is_Handle (Cur) then
            Ok := False;
            return;
         end if;
         Fetch (H, To_Handle (Cur), C, Good);
         if not Good or else C.Kind /= Cell_Pair then
            Ok := False;
            return;
         end if;
         --  Each element is itself the (key . value) binding pair.
         if not Is_Handle (C.Car) then
            Ok := False;
            return;
         end if;
         Fetch (H, To_Handle (C.Car), B, Good);
         if not Good or else B.Kind /= Cell_Pair then
            Ok := False;
            return;
         end if;
         if Same_Value (B.Car, Key) then
            Val := B.Cdr;
            Found := True;
            return;
         end if;
         Cur := C.Cdr;
         Left := Left - 1;
      end loop;
   end Lookup_Binding;

   procedure Bind
     (H      : in out Heap_Type;
      Sym    : Value;
      Val    : Value;
      Vars   : in out Value;
      Ok     : out Boolean)
     with
       Pre  => H.Ready,
       Post => H.Ready
   is
      Item : Value;
   begin
      Cons (H, Sym, Val, Item, Ok);
      if not Ok then
         return;
      end if;
      declare
         New_Vars : Value;
      begin
         Cons (H, Item, Vars, New_Vars, Ok);
         if Ok then
            Vars := New_Vars;
         end if;
      end;
   end Bind;

   --  Add one value to the list stored for Sym in Reps, creating the entry if
   --  this is the first repetition.  Appending keeps the source order that
   --  the template sees.
   procedure Rep_Add
     (H    : in out Heap_Type;
      Sym  : Value;
      Val  : Value;
      Reps : in out Value;
      Ok   : out Boolean)
     with
       Pre  => H.Ready,
       Post => H.Ready
   is
      Old   : Value;
      Found : Boolean;
      Good  : Boolean;
      Cur   : Value;
      Acc   : Value;
      Item  : Value;
      Rev   : Value;
      New_L : Value;
      Left  : Natural := Max_List_Length + 1;
   begin
      Lookup_Binding (H, Reps, Sym, Old, Found, Good);
      if not Good then
         Ok := False;
         return;
      end if;
      if Found then
         --  Reverse Old, cons Val, reverse back: append in one pass each way.
         Cur := Old;
         Acc := Nil_Value;
         while not Is_Nil (Cur) and then Left > 0 loop
            pragma Loop_Invariant (H.Ready);
            pragma Loop_Variant (Decreases => Left);
            if not Is_Handle (Cur) then
               Ok := False;
               return;
            end if;
            declare
               C : Cell;
            begin
               Fetch (H, To_Handle (Cur), C, Good);
               if not Good or else C.Kind /= Cell_Pair then
                  Ok := False;
                  return;
               end if;
               Cons (H, C.Car, Acc, Item, Ok);
               if not Ok then
                  return;
               end if;
               Acc := Item;
               Cur := C.Cdr;
               Left := Left - 1;
            end;
         end loop;
         Cons (H, Val, Acc, Rev, Ok);
         if not Ok then
            return;
         end if;
         Reverse_List (H, Rev, New_L, Ok);
      else
         Cons (H, Val, Nil_Value, New_L, Ok);
      end if;
      if not Ok then
         return;
      end if;
      Cons (H, Sym, New_L, Item, Ok);
      if not Ok then
         return;
      end if;
      declare
         New_Reps : Value;
      begin
         Cons (H, Item, Reps, New_Reps, Ok);
         if Ok then
            Reps := New_Reps;
         end if;
      end;
   end Rep_Add;

   ----------------------------------------------------------------------------
   --  Repetition trees
   --
   --  A pattern variable bound under one or more ellipses maps to a tree:
   --  a plain value at depth zero, or a Cell_Values node whose Car is the
   --  list of the next level's trees.  Cell_Values is used only inside this
   --  unit as an internal marker; it never reaches the evaluator.
   ----------------------------------------------------------------------------

   procedure New_Rep_Node
     (H        : in out Heap_Type;
      Children : Value;
      Result   : out Value;
      Ok       : out Boolean)
     with
       Pre  => H.Ready,
       Post => H.Ready
   is
      Hd : Handle;
   begin
      Result := Nil_Value;
      Allocate (H, Cell_Values, Hd, Ok);
      if not Ok then
         return;
      end if;
      H.Cells (Hd.Index).Car := Children;
      H.Cells (Hd.Index).Cdr := Nil_Value;
      Result := From_Handle (Hd);
   end New_Rep_Node;

   procedure Rep_Children
     (H        : Heap_Type;
      V        : Value;
      Children : out Value;
      Is_Node  : out Boolean;
      Ok       : out Boolean)
     with Pre => H.Ready
   is
      C    : Cell;
      Good : Boolean;
   begin
      Children := Nil_Value;
      Is_Node := False;
      Ok := True;
      if not Is_Handle (V) then
         return;
      end if;
      Fetch (H, To_Handle (V), C, Good);
      if not Good then
         Ok := False;
         return;
      end if;
      if C.Kind = Cell_Values then
         Children := C.Car;
         Is_Node := True;
      end if;
   end Rep_Children;

   function Is_Rep_Node (H : Heap_Type; V : Value) return Boolean
     with Pre => H.Ready
   is
      C    : Cell;
      Good : Boolean;
   begin
      if not Is_Handle (V) then
         return False;
      end if;
      Fetch (H, To_Handle (V), C, Good);
      return Good and then C.Kind = Cell_Values;
   end Is_Rep_Node;

   --  Follow Path (Level .. Depth) down a repetition tree.  Level starts at
   --  1; when it exceeds Depth the tree itself is the result.
   procedure Descend
     (H      : Heap_Type;
      Tree   : Value;
      Path   : Path_Array;
      Level  : Positive;
      Depth  : Natural;
      Result : out Value;
      Ok     : out Boolean)
     with
       Pre  => H.Ready
         and then Level in 1 .. Max_Ellipsis_Depth + 1
         and then Depth <= Max_Ellipsis_Depth,
       Subprogram_Variant => (Decreases => Depth - Level)
   is
      Children : Value;
      Is_Node  : Boolean;
      Child    : Value;
      Good     : Boolean;
   begin
      Result := Nil_Value;
      if Level > Depth then
         Result := Tree;
         Ok := True;
         return;
      end if;
      Rep_Children (H, Tree, Children, Is_Node, Good);
      if not Good or else not Is_Node then
         Ok := False;
         return;
      end if;
      pragma Assert (Level <= Max_Ellipsis_Depth);
      Nth (H, Children, Path (Level), Child, Good);
      if not Good then
         Ok := False;
         return;
      end if;
      Descend (H, Child, Path, Level + 1, Depth, Result, Ok);
   end Descend;

   --  Every variable that occurs in a pattern, used to seed an empty
   --  repetition tree so that a zero-length match still binds the variable.
   procedure Collect_Pattern_Vars
     (H    : in out Heap_Type;
      Pat  : Value;
      Lits : Value;
      Acc  : in out Value;
      Fuel : Natural;
      Ok   : out Boolean)
     with
       Pre  => H.Ready,
       Post => H.Ready,
       Subprogram_Variant => (Decreases => Fuel)
   is
      C    : Cell;
      Good : Boolean;
   begin
      Ok := False;
      if Fuel = 0 then
         return;
      end if;
      if not Is_Handle (Pat) then
         Ok := True;
         return;
      end if;
      Fetch (H, To_Handle (Pat), C, Good);
      if not Good then
         return;
      end if;
      if C.Kind = Cell_Symbol then
         if Is_Ellipsis (H, Pat)
           or else Is_Symbol_Named (H, Pat, "_")
           or else Is_Literal (H, Pat, Lits)
           or else Member_Binding (H, Acc, Pat)
         then
            Ok := True;
            return;
         end if;
         Bind (H, Pat, Nil_Value, Acc, Ok);
         return;
      end if;
      if C.Kind /= Cell_Pair then
         Ok := True;
         return;
      end if;
      Collect_Pattern_Vars (H, C.Car, Lits, Acc, Fuel - 1, Good);
      if not Good then
         return;
      end if;
      Collect_Pattern_Vars (H, C.Cdr, Lits, Acc, Fuel - 1, Ok);
   end Collect_Pattern_Vars;

   --  Match Pat against Form, extending the pattern-variable tree table.
   procedure Match
     (H     : in out Heap_Type;
      Pat   : Value;
      Form  : Value;
      Lits  : Value;
      Vars  : in out Value;
      Fuel  : Natural;
      Ok    : out Boolean)
     with
       Pre  => H.Ready,
       Post => H.Ready,
       Subprogram_Variant => (Decreases => Fuel)
   is
      PC       : Cell;
      FC       : Cell;
      Good     : Boolean;
      Pat_Rest : Value;
      Maybe_Ell : Value;
      Tail     : Value;
      Elem     : Value;
      Cur      : Value;
      Sub_Vars : Value;
      Seed     : Value;
      Gather   : Value;
      Left     : Natural;
      Inner_Left : Natural;
   begin
      Ok := False;
      if Fuel = 0 then
         return;
      end if;

      if Is_Nil (Pat) then
         Ok := Is_Nil (Form);
         return;
      end if;

      if not Is_Handle (Pat) then
         Ok := Same_Value (Pat, Form);
         return;
      end if;
      Fetch (H, To_Handle (Pat), PC, Good);
      if not Good then
         return;
      end if;

      if PC.Kind = Cell_Symbol then
         if Is_Ellipsis (H, Pat) then
            return;
         end if;
         if Is_Symbol_Named (H, Pat, "_") then
            Ok := True;
            return;
         end if;
         if Is_Literal (H, Pat, Lits) then
            Ok := Is_Handle (Form) and then Same_Value (Pat, Form);
            return;
         end if;
         Bind (H, Pat, Form, Vars, Ok);
         return;
      end if;
      if PC.Kind /= Cell_Pair then
         Ok := Same_Value (Pat, Form);
         return;
      end if;

      Cdr_Of (H, Pat, Pat_Rest, Good);
      if not Good then
         return;
      end if;

      --  (subpattern ...) -- a trailing repetition at this level.  Nested
      --  repetitions are handled by the recursive Match on the subpattern;
      --  each iteration's bindings become one level of the variable's tree.
      if Is_Handle (Pat_Rest) then
         Fetch (H, To_Handle (Pat_Rest), FC, Good);
         if not Good then
            return;
         end if;
         if FC.Kind = Cell_Pair then
            Car_Of (H, Pat_Rest, Maybe_Ell, Good);
            if not Good then
               return;
            end if;
            if Is_Ellipsis (H, Maybe_Ell) then
               Cdr_Of (H, Pat_Rest, Tail, Good);
               if not Good or else not Is_Nil (Tail) then
                  return;
               end if;

               --  Seed the accumulator with every variable in the repeated
               --  subpattern, so a zero-length match still binds it (to an
               --  empty repetition).
               Gather := Nil_Value;
               Seed := Nil_Value;
               Collect_Pattern_Vars (H, PC.Car, Lits, Seed, Fuel - 1, Good);
               if not Good then
                  return;
               end if;
               declare
                  S : Value := Seed;
                  SC : Cell;
                  SP : Cell;
               begin
                  Left := Max_List_Length + 1;
                  while not Is_Nil (S) and then Left > 0 loop
                     pragma Loop_Invariant (H.Ready);
                     pragma Loop_Variant (Decreases => Left);
                     if not Is_Handle (S) then
                        return;
                     end if;
                     Fetch (H, To_Handle (S), SC, Good);
                     if not Good
                       or else SC.Kind /= Cell_Pair
                       or else not Is_Handle (SC.Car)
                     then
                        return;
                     end if;
                     Fetch (H, To_Handle (SC.Car), SP, Good);
                     if not Good or else SP.Kind /= Cell_Pair then
                        return;
                     end if;
                     Bind (H, SP.Car, Nil_Value, Gather, Good);
                     if not Good then
                        return;
                     end if;
                     S := SC.Cdr;
                     Left := Left - 1;
                  end loop;
               end;

               --  Form must be a proper list; every element matches the
               --  repeated subpattern and contributes one tree per variable.
               Cur := Form;
               Left := Max_List_Length + 1;
               while not Is_Nil (Cur) and then Left > 0 loop
                  pragma Loop_Invariant (H.Ready);
                  pragma Loop_Variant (Decreases => Left);
                  if not Is_Handle (Cur) then
                     return;
                  end if;
                  Fetch (H, To_Handle (Cur), FC, Good);
                  if not Good or else FC.Kind /= Cell_Pair then
                     return;
                  end if;
                  Elem := FC.Car;
                  Sub_Vars := Nil_Value;
                  Match (H, PC.Car, Elem, Lits, Sub_Vars, Fuel - 1, Good);
                  if not Good then
                     return;
                  end if;
                  declare
                     Bind_Cur : Value := Sub_Vars;
                     Bind_C   : Cell;
                     Bind_P   : Cell;
                  begin
                     Inner_Left := Max_List_Length + 1;
                     while not Is_Nil (Bind_Cur) and then Inner_Left > 0 loop
                        pragma Loop_Invariant (H.Ready);
                        pragma Loop_Variant (Decreases => Inner_Left);
                        if not Is_Handle (Bind_Cur) then
                           return;
                        end if;
                        Fetch (H, To_Handle (Bind_Cur), Bind_C, Good);
                        if not Good
                          or else Bind_C.Kind /= Cell_Pair
                          or else not Is_Handle (Bind_C.Car)
                        then
                           return;
                        end if;
                        Fetch (H, To_Handle (Bind_C.Car), Bind_P, Good);
                        if not Good or else Bind_P.Kind /= Cell_Pair then
                           return;
                        end if;
                        Rep_Add (H, Bind_P.Car, Bind_P.Cdr, Gather, Good);
                        if not Good then
                           return;
                        end if;
                        Bind_Cur := Bind_C.Cdr;
                        Inner_Left := Inner_Left - 1;
                     end loop;
                  end;
                  Cur := FC.Cdr;
                  Left := Left - 1;
               end loop;

               --  Wrap each gathered list in one repetition node and add it
               --  to the enclosing table.
               declare
                  G : Value := Gather;
                  GC : Cell;
                  GP : Cell;
                  Node : Value;
               begin
                  Left := Max_List_Length + 1;
                  while not Is_Nil (G) and then Left > 0 loop
                     pragma Loop_Invariant (H.Ready);
                     pragma Loop_Variant (Decreases => Left);
                     if not Is_Handle (G) then
                        return;
                     end if;
                     Fetch (H, To_Handle (G), GC, Good);
                     if not Good
                       or else GC.Kind /= Cell_Pair
                       or else not Is_Handle (GC.Car)
                     then
                        return;
                     end if;
                     Fetch (H, To_Handle (GC.Car), GP, Good);
                     if not Good or else GP.Kind /= Cell_Pair then
                        return;
                     end if;
                     --  Rep_Add leaves its older entries behind; the newest
                     --  one (first in the list) is the complete children
                     --  list.  Wrap each variable once.
                     if not Member_Binding (H, Vars, GP.Car) then
                        New_Rep_Node (H, GP.Cdr, Node, Good);
                        if not Good then
                           return;
                        end if;
                        Bind (H, GP.Car, Node, Vars, Good);
                        if not Good then
                           return;
                        end if;
                     end if;
                     G := GC.Cdr;
                     Left := Left - 1;
                  end loop;
               end;
               Ok := True;
               return;
            end if;
         end if;
      end if;

      --  Ordinary pair: both must be pairs, then match car and cdr.
      if not Is_Handle (Form) then
         return;
      end if;
      Fetch (H, To_Handle (Form), FC, Good);
      if not Good or else FC.Kind /= Cell_Pair then
         return;
      end if;
      Match (H, PC.Car, FC.Car, Lits, Vars, Fuel - 1, Good);
      if not Good then
         return;
      end if;
      Match (H, PC.Cdr, FC.Cdr, Lits, Vars, Fuel - 1, Ok);
   end Match;

   --  Find a repetition variable inside T at the current ellipsis depth and
   --  report its length.  This is what gives a template ellipsis its
   --  iteration count; nested ellipses descend the same tree.
   procedure Rep_Count
     (H     : Heap_Type;
      T     : Value;
      Vars  : Value;
      Path  : Path_Array;
      Depth : Natural;
      N     : out Natural;
      Found : out Boolean;
      Fuel  : Natural;
      Ok    : out Boolean)
     with
       Pre  => H.Ready and then Depth <= Max_Ellipsis_Depth,
       Post => (if Ok then N <= Max_List_Length),
       Subprogram_Variant => (Decreases => Fuel)
   is
      C    : Cell;
      Good : Boolean;
      V    : Value;
      Sub  : Natural;
      Sub_Found : Boolean;
      Tree : Value;
      Children : Value;
      Is_Node  : Boolean;
   begin
      N := 0;
      Found := False;
      Ok := True;
      if Fuel = 0 then
         return;
      end if;
      if not Is_Handle (T) then
         return;
      end if;
      Fetch (H, To_Handle (T), C, Good);
      if not Good then
         Ok := False;
         return;
      end if;
      if C.Kind = Cell_Symbol then
         if not Member_Binding (H, Vars, T) then
            return;
         end if;
         Lookup_Binding (H, Vars, T, Tree, Sub_Found, Good);
         if not Good then
            Ok := False;
            return;
         end if;
         if not Sub_Found then
            return;
         end if;
         Descend (H, Tree, Path, 1, Depth, V, Good);
         if not Good then
            Ok := False;
            return;
         end if;
         Rep_Children (H, V, Children, Is_Node, Good);
         if not Good then
            Ok := False;
            return;
         end if;
         if Is_Node then
            Length (H, Children, N, Good);
            if not Good then
               Ok := False;
               return;
            end if;
            if N > Max_List_Length then
               --  The repetition count feeds the expansion budget, which
               --  is itself Max_List_Length-bounded: more repetitions
               --  than the budget can spend are rejected, not truncated.
               Ok := False;
               return;
            end if;
            Found := True;
         end if;
         return;
      end if;
      if C.Kind /= Cell_Pair then
         return;
      end if;
      Rep_Count (H, C.Car, Vars, Path, Depth, N, Found, Fuel - 1, Good);
      if not Good then
         Ok := False;
         return;
      end if;
      if Found then
         return;
      end if;
      Rep_Count (H, C.Cdr, Vars, Path, Depth, Sub, Sub_Found, Fuel - 1, Ok);
      if not Ok then
         return;
      end if;
      if Sub_Found then
         N := Sub;
         Found := True;
      end if;
   end Rep_Count;

   ----------------------------------------------------------------------------
   --  Fresh identifiers
   ----------------------------------------------------------------------------

   procedure Make_Fresh_Name
     (N   : Natural;
      Buf : out String;
      Len : out Natural)
     with
       Pre  => N <= Max_Fresh
         and then Buf'First = 1
         and then Buf'Length = 12,
       Post => Len = 12
   is
      Pow  : constant array (0 .. 9) of Integer_64 :=
        (1, 10, 100, 1_000, 10_000, 100_000, 1_000_000, 10_000_000,
         100_000_000, 1_000_000_000);
      Digit_Chars : constant String := "0123456789";
      D      : Integer_64;
   begin
      for I in Buf'Range loop
         Buf (I) := ' ';
      end loop;
      Buf (1) := '%';
      Buf (2) := 'h';
      for I in 0 .. 9 loop
         pragma Loop_Invariant (Buf'First = 1);
         D := (Integer_64 (N) / Pow (9 - I)) mod 10;
         Buf (3 + I) := Digit_Chars (Natural (D) + 1);
      end loop;
      Len := 12;
   end Make_Fresh_Name;

   function Symbol_Exists (H : Heap_Type; Name : String) return Boolean
     with Pre => H.Ready
       and then Name'First >= 1
       and then Name'Last < Natural'Last
       and then Name'Length <= Max_Text
   is
   begin
      for I in Valid_Cell_Index loop
         pragma Loop_Invariant (H.Ready);
         if H.Cells (I).Kind = Cell_Symbol
           and then H.Cells (I).Name_Len = Name'Length
           and then H.Cells (I).Name (1 .. H.Cells (I).Name_Len) = Name
         then
            return True;
         end if;
      end loop;
      return False;
   end Symbol_Exists;

   procedure Fresh
     (H       : in out Heap_Type;
      Counter : in out Natural;
      Result  : out Value;
      Ok      : out Boolean)
     with
       Pre  => H.Ready and then Counter <= Max_Fresh,
       Post => H.Ready and then Counter <= Max_Fresh
   is
      Buf  : String (1 .. 12);
      Len  : Natural;
      Cand : Natural := Counter;
   begin
      Result := Nil_Value;
      Ok := False;
      loop
         pragma Loop_Invariant (H.Ready);
         pragma Loop_Invariant (Cand <= Max_Fresh);
         pragma Loop_Variant (Increases => Cand);
         if Cand >= Max_Fresh then
            return;
         end if;
         Cand := Cand + 1;
         Make_Fresh_Name (Cand, Buf, Len);
         if not Symbol_Exists (H, Buf (1 .. Len)) then
            Intern (H, Buf (1 .. Len), Result, Ok);
            if Ok then
               Counter := Cand;
            end if;
            return;
         end if;
      end loop;
   end Fresh;

   ----------------------------------------------------------------------------
   --  Template instantiation
   ----------------------------------------------------------------------------

   procedure Inst
     (H        : in out Heap_Type;
      Tmpl     : Value;
      Vars     : Value;
      Ren  : Value;
      Path     : Path_Array;
      Depth    : Natural;
      No_Rename : Boolean;
      Result   : out Value;
      Fuel     : Natural;
      Counter  : in out Natural;
      Ok       : out Boolean)
     with
       Pre  => H.Ready and then Counter <= Max_Fresh
         and then Depth <= Max_Ellipsis_Depth,
       Post => H.Ready and then Counter <= Max_Fresh,
       Subprogram_Variant => (Decreases => Fuel);

   procedure Inst_Seq
     (H       : in out Heap_Type;
      Forms   : Value;
      Vars    : Value;
      Ren : Value;
      Path    : Path_Array;
      Depth   : Natural;
      Result  : out Value;
      Fuel    : Natural;
      Counter : in out Natural;
      Ok      : out Boolean)
     with
       Pre  => H.Ready and then Counter <= Max_Fresh
         and then Depth <= Max_Ellipsis_Depth,
       Post => H.Ready and then Counter <= Max_Fresh,
       Subprogram_Variant => (Decreases => Fuel);

   procedure Inst_Formals
     (H       : in out Heap_Type;
      Formals : Value;
      Vars    : Value;
      Ren : Value;
      Path    : Path_Array;
      Depth   : Natural;
      New_Formals : out Value;
      New_Renames : out Value;
      Fuel    : Natural;
      Counter : in out Natural;
      Ok      : out Boolean)
     with
       Pre  => H.Ready and then Counter <= Max_Fresh
         and then Depth <= Max_Ellipsis_Depth,
       Post => H.Ready and then Counter <= Max_Fresh,
       Subprogram_Variant => (Decreases => Fuel);

   --  Substitute one identifier: a pattern variable yields its tree value at
   --  the current ellipsis path; an introduced identifier is renamed by the
   --  lexical hygiene environment; anything else is left alone.
   procedure Subst_Symbol
     (H       : Heap_Type;
      Sym     : Value;
      Vars    : Value;
      Ren : Value;
      Path    : Path_Array;
      Depth   : Natural;
      No_Rename : Boolean;
      Result  : out Value;
      Ok      : out Boolean)
     with
       Pre  => H.Ready and then Depth <= Max_Ellipsis_Depth
   is
      V     : Value;
      New_S : Value;
      Found : Boolean;
      Good  : Boolean;
   begin
      Result := Sym;
      Ok := True;
      if Member_Binding (H, Vars, Sym) then
         Lookup_Binding (H, Vars, Sym, V, Found, Good);
         if not Good or else not Found then
            Ok := False;
            return;
         end if;
         Descend (H, V, Path, 1, Depth, Result, Good);
         if not Good then
            Ok := False;
            return;
         end if;
         --  A repeated variable referenced without enough ellipses would
         --  leak the internal repetition node; reject it.
         if Is_Rep_Node (H, Result) then
            Ok := False;
         end if;
         return;
      end if;
      if No_Rename then
         return;
      end if;
      Lookup_Binding (H, Ren, Sym, New_S, Found, Good);
      if not Good then
         Ok := False;
         return;
      end if;
      if Found then
         Result := New_S;
      end if;
   end Subst_Symbol;

   --  Instantiate a lambda-style formal list, generating fresh names for
   --  binders introduced by the template and extending the rename
   --  environment for the body.  Pattern variables in the list are caller
   --  identifiers and are never renamed.
   procedure Inst_Formals
     (H       : in out Heap_Type;
      Formals : Value;
      Vars    : Value;
      Ren : Value;
      Path    : Path_Array;
      Depth   : Natural;
      New_Formals : out Value;
      New_Renames : out Value;
      Fuel    : Natural;
      Counter : in out Natural;
      Ok      : out Boolean)
   is
      C     : Cell;
      Good  : Boolean;
      Head  : Value;
      Tail  : Value;
      New_Head : Value;
      New_Tail : Value;
      Env_Tail : Value;
      Fresh_S : Value;
      Item  : Value;
   begin
      New_Formals := Nil_Value;
      New_Renames := Ren;
      Ok := False;
      if Fuel = 0 then
         return;
      end if;

      if Is_Nil (Formals) then
         Ok := True;
         return;
      end if;

      if not Is_Handle (Formals) then
         --  A non-list value in formal position is left for the evaluator to
         --  diagnose; just pass it through.
         Inst (H, Formals, Vars, Ren, Path, Depth, False,
               New_Formals, Fuel - 1, Counter, Ok);
         return;
      end if;

      Fetch (H, To_Handle (Formals), C, Good);
      if not Good then
         return;
      end if;

      if C.Kind = Cell_Symbol then
         --  A rest-argument binder, or a pattern variable standing for the
         --  whole formal list.
         Subst_Symbol (H, Formals, Vars, Ren, Path, Depth, False,
                       New_Formals, Good);
         if not Good then
            return;
         end if;
         if not Member_Binding (H, Vars, Formals)
           and then Is_Handle (New_Formals)
         then
            Fresh (H, Counter, Fresh_S, Good);
            if not Good then
               return;
            end if;
            Bind (H, Formals, Fresh_S, New_Renames, Good);
            if not Good then
               return;
            end if;
            New_Formals := Fresh_S;
         end if;
         Ok := True;
         return;
      end if;

      if C.Kind /= Cell_Pair then
         Inst (H, Formals, Vars, Ren, Path, Depth, False,
               New_Formals, Fuel - 1, Counter, Ok);
         return;
      end if;

      Head := C.Car;
      Tail := C.Cdr;

      --  Formal-list element.
      if Is_Handle (Head) and then Member_Binding (H, Vars, Head) then
         Subst_Symbol (H, Head, Vars, Ren, Path, Depth, False,
                       New_Head, Good);
         if not Good then
            return;
         end if;
      elsif Is_Handle (Head) then
         Fresh (H, Counter, Fresh_S, Good);
         if not Good then
            return;
         end if;
         Bind (H, Head, Fresh_S, New_Renames, Good);
         if not Good then
            return;
         end if;
         New_Head := Fresh_S;
      else
         Inst (H, Head, Vars, Ren, Path, Depth, False,
               New_Head, Fuel - 1, Counter, Good);
         if not Good then
            return;
         end if;
      end if;

      Env_Tail := New_Renames;
      Inst_Formals (H, Tail, Vars, Env_Tail, Path, Depth,
                    New_Tail, New_Renames, Fuel - 1, Counter, Good);
      if not Good then
         return;
      end if;
      Cons (H, New_Head, New_Tail, Item, Good);
      if not Good then
         return;
      end if;
      New_Formals := Item;
      Ok := True;
   end Inst_Formals;

   --  Pre-scan a body for internal definitions and extend the rename
   --  environment with a fresh name for each binder the template introduces.
   --  The whole body is then instantiated in that environment, matching the
   --  letrec* scoping R7RS gives internal definitions.
   procedure Build_Body_Env
     (H       : in out Heap_Type;
      Forms   : Value;
      Vars    : Value;
      Base    : Value;
      Counter : in out Natural;
      Env     : out Value;
      Ok      : out Boolean)
     with
       Pre  => H.Ready and then Counter <= Max_Fresh,
       Post => H.Ready and then Counter <= Max_Fresh
   is
      Cur    : Value := Forms;
      Left   : Natural := Max_List_Length + 1;
      C      : Cell;
      R      : Cell;
      T      : Cell;
      Hd     : Cell;
      Good   : Boolean;
      Target : Value;
      Name   : Value;
      Fresh_S : Value;
   begin
      Env := Base;
      Ok := True;
      while not Is_Nil (Cur) and then Left > 0 loop
         pragma Loop_Invariant (H.Ready);
         pragma Loop_Invariant (Counter <= Max_Fresh);
         pragma Loop_Variant (Decreases => Left);
         if not Is_Handle (Cur) then
            Ok := False;
            return;
         end if;
         Fetch (H, To_Handle (Cur), C, Good);
         if not Good or else C.Kind /= Cell_Pair then
            Ok := False;
            return;
         end if;
         Target := Nil_Value;
         if Is_Handle (C.Car) then
            Fetch (H, To_Handle (C.Car), Hd, Good);
            if Good and then Hd.Kind = Cell_Pair
              and then Is_Symbol_Named (H, Hd.Car, "define")
              and then not Member_Binding (H, Vars, Hd.Car)
              and then Is_Handle (Hd.Cdr)
            then
               Fetch (H, To_Handle (Hd.Cdr), R, Good);
               if Good and then R.Kind = Cell_Pair then
                  Target := R.Car;
               end if;
            end if;
         end if;
         --  The binder of an internal definition is the target itself when
         --  it is a symbol, or the head of a (name . formals) target.
         Name := Nil_Value;
         if Is_Handle (Target) then
            Fetch (H, To_Handle (Target), T, Good);
            if Good and then T.Kind = Cell_Symbol then
               Name := Target;
            elsif Good and then T.Kind = Cell_Pair
              and then Is_Handle (T.Car)
            then
               Name := T.Car;
            end if;
         end if;
         if Is_Handle (Name) and then not Member_Binding (H, Vars, Name) then
            declare
               Nm : Cell;
            begin
               Fetch (H, To_Handle (Name), Nm, Good);
               if Good and then Nm.Kind = Cell_Symbol then
                  Fresh (H, Counter, Fresh_S, Good);
                  if not Good then
                     Ok := False;
                     return;
                  end if;
                  Bind (H, Name, Fresh_S, Env, Good);
                  if not Good then
                     Ok := False;
                     return;
                  end if;
               end if;
            end;
         end if;
         Cur := C.Cdr;
         Left := Left - 1;
      end loop;
   end Build_Body_Env;

   --  Instantiate a body sequence: pre-scan internal definitions, then every
   --  form in the extended rename environment.
   procedure Inst_Seq
     (H       : in out Heap_Type;
      Forms   : Value;
      Vars    : Value;
      Ren : Value;
      Path    : Path_Array;
      Depth   : Natural;
      Result  : out Value;
      Fuel    : Natural;
      Counter : in out Natural;
      Ok      : out Boolean)
   is
      Env    : Value;
      Cur    : Value := Forms;
      Acc    : Value := Nil_Value;
      Elem   : Value;
      C      : Cell;
      Item   : Value;
      Left   : Natural := Max_List_Length + 1;
      Good   : Boolean;
   begin
      Result := Nil_Value;
      Ok := False;
      if Fuel = 0 then
         return;
      end if;
      Build_Body_Env (H, Forms, Vars, Ren, Counter, Env, Good);
      if not Good then
         return;
      end if;
      while not Is_Nil (Cur) and then Left > 0 loop
         pragma Loop_Invariant (H.Ready);
         pragma Loop_Invariant (Counter <= Max_Fresh);
         pragma Loop_Variant (Decreases => Left);
         if not Is_Handle (Cur) then
            return;
         end if;
         Fetch (H, To_Handle (Cur), C, Good);
         if not Good or else C.Kind /= Cell_Pair then
            return;
         end if;
         Inst (H, C.Car, Vars, Env, Path, Depth, False,
               Elem, Fuel - 1, Counter, Good);
         if not Good then
            return;
         end if;
         Cons (H, Elem, Acc, Item, Good);
         if not Good then
            return;
         end if;
         Acc := Item;
         Cur := C.Cdr;
         Left := Left - 1;
      end loop;
      Reverse_List (H, Acc, Result, Ok);
   end Inst_Seq;

   procedure Inst
     (H        : in out Heap_Type;
      Tmpl     : Value;
      Vars     : Value;
      Ren  : Value;
      Path     : Path_Array;
      Depth    : Natural;
      No_Rename : Boolean;
      Result   : out Value;
      Fuel     : Natural;
      Counter  : in out Natural;
      Ok       : out Boolean)
   is
      C        : Cell;
      HC       : Cell;
      RC       : Cell;
      Good     : Boolean;
      Head     : Value;
      Rest     : Value;
      Head_Is  : Boolean;
      Maybe_Ell : Value;
      Tail     : Value;
      Sub      : Value;
      N        : Natural;
      Has      : Boolean;
      Acc      : Value;
      Elem     : Value;
      Item     : Value;
      Tmp      : Value;
      Sub_Rest : Value;
      New_Head : Value;
      New_Tail : Value;
      Body_Out : Value;
      Init_Tmp : Value;
   begin
      Result := Nil_Value;
      Ok := False;
      if Fuel = 0 then
         return;
      end if;

      if Is_Handle (Tmpl) then
         Fetch (H, To_Handle (Tmpl), C, Good);
         if not Good then
            return;
         end if;
      end if;

      if Is_Handle (Tmpl) and then C.Kind = Cell_Symbol then
         if Is_Ellipsis (H, Tmpl) then
            return;
         end if;
         Subst_Symbol (H, Tmpl, Vars, Ren, Path, Depth, No_Rename,
                       Result, Ok);
         return;
      end if;

      if not Is_Handle (Tmpl) then
         Result := Tmpl;
         Ok := True;
         return;
      end if;
      if C.Kind /= Cell_Pair then
         Result := Tmpl;
         Ok := True;
         return;
      end if;

      Cdr_Of (H, Tmpl, Rest, Good);
      if not Good then
         return;
      end if;

      --  (subtemplate ...): repeat the subtemplate N times.  Rep_Count
      --  descends the tree at the current path, so a nested ellipsis gets
      --  the length of that level.
      if Is_Handle (Rest) then
         Fetch (H, To_Handle (Rest), RC, Good);
         if not Good then
            return;
         end if;
         if RC.Kind = Cell_Pair then
            Car_Of (H, Rest, Maybe_Ell, Good);
            if not Good then
               return;
            end if;
            if Is_Ellipsis (H, Maybe_Ell) then
               Cdr_Of (H, Rest, Tail, Good);
               if not Good or else not Is_Nil (Tail) then
                  return;
               end if;
               if Depth >= Max_Ellipsis_Depth then
                  return;
               end if;
               Car_Of (H, Tmpl, Sub, Good);
               if not Good then
                  return;
               end if;
               Rep_Count (H, Sub, Vars, Path, Depth, N, Has,
                          Fuel - 1, Good);
               if not Good or else not Has then
                  return;
               end if;
               Acc := Nil_Value;
               declare
                  Inner_Path : Path_Array := Path;
               begin
                  if N > 0 then
                     for I in 0 .. N - 1 loop
                        pragma Loop_Invariant (H.Ready);
                        pragma Loop_Invariant (Counter <= Max_Fresh);
                        pragma Loop_Invariant (Fuel >= 1);
                        Inner_Path (Depth + 1) := I;
                        Inst (H, Sub, Vars, Ren, Inner_Path,
                              Depth + 1, No_Rename, Elem,
                              Fuel - 1, Counter, Good);
                        if not Good then
                           return;
                        end if;
                        Cons (H, Elem, Acc, Tmp, Good);
                        if not Good then
                           return;
                        end if;
                        Acc := Tmp;
                     end loop;
                  end if;
               end;
               Reverse_List (H, Acc, Result, Good);
               Ok := Good;
               return;
            end if;
         end if;
      end if;

      --  Binding forms introduced by the template.  A head that is itself a
      --  pattern variable is caller code and is instantiated normally, so it
      --  is never treated as syntax here.
      Car_Of (H, Tmpl, Head, Good);
      Head_Is := False;
      if Good and then not No_Rename and then Is_Handle (Head) then
         Fetch (H, To_Handle (Head), HC, Good);
         if Good and then HC.Kind = Cell_Symbol
           and then not Member_Binding (H, Vars, Head)
         then
            Head_Is := True;
         end if;
      end if;

      --  quote: pattern variables still substitute, but the contents are
      --  data and no identifier is renamed.
      if Head_Is and then Is_Symbol_Named (H, Head, "quote") then
         if Is_Handle (Rest) then
            Fetch (H, To_Handle (Rest), RC, Good);
            if Good and then RC.Kind = Cell_Pair
              and then Is_Nil (RC.Cdr)
            then
               Inst (H, RC.Car, Vars, Ren, Path, Depth, True,
                     New_Tail, Fuel - 1, Counter, Good);
               if not Good then
                  return;
               end if;
               Cons (H, New_Tail, Nil_Value, Tmp, Good);
               if not Good then
                  return;
               end if;
               Cons (H, Head, Tmp, Result, Good);
               Ok := Good;
               return;
            end if;
         end if;
      end if;

      --  lambda
      if Head_Is and then Is_Symbol_Named (H, Head, "lambda") then
         if Is_Handle (Rest) then
            Car_Of (H, Rest, Sub, Good);
            if Good then
               Cdr_Of (H, Rest, Sub_Rest, Good);
            end if;
            if Good then
               Inst_Formals (H, Sub, Vars, Ren, Path, Depth,
                             New_Head, New_Tail, Fuel - 1, Counter, Good);
            end if;
            if Good then
               Inst_Seq (H, Sub_Rest, Vars, New_Tail, Path, Depth,
                         Body_Out, Fuel - 1, Counter, Good);
               New_Tail := Body_Out;
            end if;
            if Good then
               Cons (H, New_Head, New_Tail, Tmp, Good);
            end if;
            if Good then
               Cons (H, Head, Tmp, Result, Good);
            end if;
            if not Good then
               return;
            end if;
            Ok := True;
            return;
         end if;
      end if;

      --  let / let* / letrec / letrec*
      if Head_Is
        and then (Is_Symbol_Named (H, Head, "let")
                    or else Is_Symbol_Named (H, Head, "let*")
                    or else Is_Symbol_Named (H, Head, "letrec")
                    or else Is_Symbol_Named (H, Head, "letrec*"))
      then
         declare
            Is_Star   : constant Boolean := Is_Symbol_Named (H, Head, "let*");
            Is_Rec    : constant Boolean :=
              Is_Symbol_Named (H, Head, "letrec")
                or else Is_Symbol_Named (H, Head, "letrec*");
            Spec      : Value;
            Binds     : Value;
            Body_Forms : Value;
            After_Spec : Value;
            New_Binds : Value;
            Body_Env  : Value;
            Vars_Env  : Value;
            Init_Env  : Value;
            Cur       : Value;
            Cur_C     : Cell;
            Bnd       : Cell;
            Bnd_C     : Cell;
            Var       : Value;
            Init      : Value;
            New_Var   : Value;
            New_Init  : Value;
            Fresh_S   : Value;
            Pair_Rest : Value;
            Pair_Tail : Value;
            Acc       : Value := Nil_Value;
            New_Vars  : Value := Nil_Value;
            New_Name  : Value := Nil_Value;
            Named     : Boolean := False;
            Left      : Natural;
            Tmp2      : Value;
         begin
            Car_Of (H, Rest, Spec, Good);
            if not Good then
               return;
            end if;
            if Is_Handle (Spec) then
               Fetch (H, To_Handle (Spec), HC, Good);
               if not Good then
                  return;
               end if;
            end if;

            if Is_Handle (Spec) and then HC.Kind = Cell_Symbol then
               --  Named let: (let name ((var init) ...) body ...).
               Named := True;
               if Member_Binding (H, Vars, Spec) then
                  Subst_Symbol (H, Spec, Vars, Ren, Path, Depth,
                                False, New_Name, Good);
                  if not Good then
                     return;
                  end if;
                  Body_Env := Ren;
               else
                  Fresh (H, Counter, Fresh_S, Good);
                  if not Good then
                     return;
                  end if;
                  Body_Env := Ren;
                  Bind (H, Spec, Fresh_S, Body_Env, Good);
                  if not Good then
                     return;
                  end if;
                  New_Name := Fresh_S;
               end if;
               Cdr_Of (H, Rest, After_Spec, Good);
               if not Good then
                  return;
               end if;
               Car_Of (H, After_Spec, Binds, Good);
               if not Good then
                  return;
               end if;
               Cdr_Of (H, After_Spec, Body_Forms, Good);
               if not Good then
                  return;
               end if;
            else
               Binds := Spec;
               Cdr_Of (H, Rest, Body_Forms, Good);
               if not Good then
                  return;
               end if;
               Body_Env := Ren;
            end if;

            Vars_Env := Body_Env;

            if Is_Rec then
               --  Pass one: fix the fresh name for every binding, all of
               --  which are visible in every initializer.
               Cur := Binds;
               Left := Max_List_Length + 1;
               while not Is_Nil (Cur) and then Left > 0 loop
                  pragma Loop_Invariant (H.Ready);
                  pragma Loop_Invariant (Counter <= Max_Fresh);
                  pragma Loop_Variant (Decreases => Left);
                  if not Is_Handle (Cur) then
                     return;
                  end if;
                  Fetch (H, To_Handle (Cur), Cur_C, Good);
                  if not Good or else Cur_C.Kind /= Cell_Pair
                    or else not Is_Handle (Cur_C.Car)
                  then
                     return;
                  end if;
                  Fetch (H, To_Handle (Cur_C.Car), Bnd, Good);
                  if not Good or else Bnd.Kind /= Cell_Pair then
                     return;
                  end if;
                  Var := Bnd.Car;
                  if Is_Handle (Var) and then Member_Binding (H, Vars, Var) then
                     Subst_Symbol (H, Var, Vars, Ren, Path, Depth,
                                   False, New_Var, Good);
                  elsif Is_Handle (Var) then
                     Fresh (H, Counter, Fresh_S, Good);
                     if Good then
                        Bind (H, Var, Fresh_S, Vars_Env, Good);
                        New_Var := Fresh_S;
                     end if;
                  else
                     New_Var := Var;
                  end if;
                  if not Good then
                     return;
                  end if;
                  Cons (H, New_Var, New_Vars, Tmp, Good);
                  if not Good then
                     return;
                  end if;
                  New_Vars := Tmp;
                  Cur := Cur_C.Cdr;
                  Left := Left - 1;
               end loop;
               if not Is_Nil (Cur) then
                  return;
               end if;
               Reverse_List (H, New_Vars, Init_Tmp, Good);
               New_Vars := Init_Tmp;
               if not Good then
                  return;
               end if;
               --  Pass two: initializers in the fully extended environment.
               Cur := Binds;
               declare
                  NV : Value := New_Vars;
                  NV_C : Cell;
               begin
                  Left := Max_List_Length + 1;
                  while not Is_Nil (Cur) and then Left > 0 loop
                     pragma Loop_Invariant (H.Ready);
                     pragma Loop_Invariant (Counter <= Max_Fresh);
                     pragma Loop_Variant (Decreases => Left);
                     if not Is_Handle (Cur) or else not Is_Handle (NV) then
                        return;
                     end if;
                     Fetch (H, To_Handle (Cur), Cur_C, Good);
                     if not Good or else Cur_C.Kind /= Cell_Pair
                       or else not Is_Handle (Cur_C.Car)
                     then
                        return;
                     end if;
                     Fetch (H, To_Handle (Cur_C.Car), Bnd, Good);
                     if not Good or else Bnd.Kind /= Cell_Pair then
                        return;
                     end if;
                     Fetch (H, To_Handle (NV), NV_C, Good);
                     if not Good or else NV_C.Kind /= Cell_Pair then
                        return;
                     end if;
                     Init := Bnd.Cdr;
                     if Is_Handle (Init) then
                        Fetch (H, To_Handle (Init), Bnd_C, Good);
                        if not Good or else Bnd_C.Kind /= Cell_Pair then
                           return;
                        end if;
                        Inst (H, Bnd_C.Car, Vars, Vars_Env, Path, Depth, False,
                              New_Init, Fuel - 1, Counter, Good);
                     else
                        New_Init := Init;
                     end if;
                     if not Good then
                        return;
                     end if;
                     Cons (H, New_Init, Nil_Value, Pair_Tail, Good);
                     if not Good then
                        return;
                     end if;
                     Cons (H, NV_C.Car, Pair_Tail, Pair_Rest, Good);
                     if not Good then
                        return;
                     end if;
                     Cons (H, Pair_Rest, Acc, Tmp, Good);
                     if not Good then
                        return;
                     end if;
                     Acc := Tmp;
                     Cur := Cur_C.Cdr;
                     NV := NV_C.Cdr;
                     Left := Left - 1;
                  end loop;
                  if not Is_Nil (Cur) then
                     return;
                  end if;
                  Reverse_List (H, Acc, New_Binds, Good);
                  if not Good then
                     return;
                  end if;
               end;
            else
               Cur := Binds;
               Left := Max_List_Length + 1;
               while not Is_Nil (Cur) and then Left > 0 loop
                  pragma Loop_Invariant (H.Ready);
                  pragma Loop_Invariant (Counter <= Max_Fresh);
                  pragma Loop_Variant (Decreases => Left);
                  if not Is_Handle (Cur) then
                     return;
                  end if;
                  Fetch (H, To_Handle (Cur), Cur_C, Good);
                  if not Good or else Cur_C.Kind /= Cell_Pair
                    or else not Is_Handle (Cur_C.Car)
                  then
                     return;
                  end if;
                  Fetch (H, To_Handle (Cur_C.Car), Bnd, Good);
                  if not Good or else Bnd.Kind /= Cell_Pair then
                     return;
                  end if;
                  Var := Bnd.Car;
                  Init := Bnd.Cdr;
                  --  For let* the name is in scope for later initializers;
                  --  the snapshot is taken before this binding is added.
                  Init_Env := (if Is_Star then Vars_Env else Ren);
                  if Is_Handle (Var) and then Member_Binding (H, Vars, Var) then
                     Subst_Symbol (H, Var, Vars, Ren, Path, Depth,
                                   False, New_Var, Good);
                  elsif Is_Handle (Var) then
                     Fresh (H, Counter, Fresh_S, Good);
                     if Good then
                        Bind (H, Var, Fresh_S, Vars_Env, Good);
                        New_Var := Fresh_S;
                     end if;
                  else
                     New_Var := Var;
                  end if;
                  if not Good then
                     return;
                  end if;
                  if Is_Handle (Init) then
                     Fetch (H, To_Handle (Init), Bnd_C, Good);
                     if not Good or else Bnd_C.Kind /= Cell_Pair then
                        return;
                     end if;
                     Inst (H, Bnd_C.Car, Vars, Init_Env, Path, Depth, False,
                           New_Init, Fuel - 1, Counter, Good);
                  else
                     New_Init := Init;
                  end if;
                  if not Good then
                     return;
                  end if;
                  Cons (H, New_Init, Nil_Value, Pair_Tail, Good);
                  if not Good then
                     return;
                  end if;
                  Cons (H, New_Var, Pair_Tail, Pair_Rest, Good);
                  if not Good then
                     return;
                  end if;
                  Cons (H, Pair_Rest, Acc, Tmp, Good);
                  if not Good then
                     return;
                  end if;
                  Acc := Tmp;
                  Cur := Cur_C.Cdr;
                  Left := Left - 1;
               end loop;
               if not Is_Nil (Cur) then
                  return;
               end if;
               Reverse_List (H, Acc, New_Binds, Good);
               if not Good then
                  return;
               end if;
            end if;

            Body_Env := Vars_Env;
            Inst_Seq (H, Body_Forms, Vars, Body_Env, Path, Depth,
                      New_Tail, Fuel - 1, Counter, Good);
            if not Good then
               return;
            end if;
            Cons (H, New_Binds, New_Tail, Tmp, Good);
            if not Good then
               return;
            end if;
            if Named then
               Cons (H, New_Name, Tmp, Tmp2, Good);
               if not Good then
                  return;
               end if;
               Cons (H, Head, Tmp2, Result, Good);
            else
               Cons (H, Head, Tmp, Result, Good);
            end if;
            Ok := Good;
            return;
         end;
      end if;

      --  do: (do ((var init step) ...) (test expr ...) body ...)
      if Head_Is and then Is_Symbol_Named (H, Head, "do") then
         declare
            Binds     : Value;
            Test_Clause : Value;
            Body_Forms      : Value;
            New_Binds : Value := Nil_Value;
            New_Clause : Value;
            New_Body  : Value;
            Vars_Env  : Value := Ren;
            Cur       : Value;
            Cur_C     : Cell;
            Bnd       : Cell;
            Bnd_Rest  : Cell;
            Var       : Value;
            Init      : Value;
            Step      : Value;
            New_Var   : Value;
            New_Init  : Value;
            New_Step  : Value;
            Fresh_S   : Value;
            Pair_Rest : Value;
            Pair_Tail : Value;
            Acc       : Value := Nil_Value;
            Left      : Natural;
         begin
            Car_Of (H, Rest, Binds, Good);
            if Good then
               Cdr_Of (H, Rest, Sub_Rest, Good);
            end if;
            if Good then
               Car_Of (H, Sub_Rest, Test_Clause, Good);
            end if;
            if Good then
               Cdr_Of (H, Sub_Rest, Body_Forms, Good);
            end if;
            if not Good then
               return;
            end if;

            --  Pass one: fix fresh names so test, steps and body all see the
            --  same binders.
            Cur := Binds;
            Left := Max_List_Length + 1;
            while not Is_Nil (Cur) and then Left > 0 loop
               pragma Loop_Invariant (H.Ready);
               pragma Loop_Invariant (Counter <= Max_Fresh);
               pragma Loop_Variant (Decreases => Left);
               if not Is_Handle (Cur) then
                  return;
               end if;
               Fetch (H, To_Handle (Cur), Cur_C, Good);
               if not Good or else Cur_C.Kind /= Cell_Pair
                 or else not Is_Handle (Cur_C.Car)
               then
                  return;
               end if;
               Fetch (H, To_Handle (Cur_C.Car), Bnd, Good);
               if not Good or else Bnd.Kind /= Cell_Pair then
                  return;
               end if;
               Var := Bnd.Car;
               if Is_Handle (Var) and then Member_Binding (H, Vars, Var) then
                  Subst_Symbol (H, Var, Vars, Ren, Path, Depth,
                                False, New_Var, Good);
               elsif Is_Handle (Var) then
                  Fresh (H, Counter, Fresh_S, Good);
                  if Good then
                     Bind (H, Var, Fresh_S, Vars_Env, Good);
                     New_Var := Fresh_S;
                  end if;
               else
                  New_Var := Var;
               end if;
               if not Good then
                  return;
               end if;
               Cons (H, New_Var, New_Binds, Tmp, Good);
               if not Good then
                  return;
               end if;
               New_Binds := Tmp;
               Cur := Cur_C.Cdr;
               Left := Left - 1;
            end loop;
            Reverse_List (H, New_Binds, Init_Tmp, Good);
            New_Binds := Init_Tmp;
            if not Good then
               return;
            end if;

            --  Pass two: initializers in the outer environment, steps in the
            --  loop environment.
            Cur := Binds;
            declare
               NV : Value := New_Binds;
               NV_C : Cell;
            begin
               Left := Max_List_Length + 1;
               while not Is_Nil (Cur) and then Left > 0 loop
                  pragma Loop_Invariant (H.Ready);
                  pragma Loop_Invariant (Counter <= Max_Fresh);
                  pragma Loop_Variant (Decreases => Left);
                  if not Is_Handle (Cur) or else not Is_Handle (NV) then
                     return;
                  end if;
                  Fetch (H, To_Handle (Cur), Cur_C, Good);
                  if not Good or else Cur_C.Kind /= Cell_Pair
                    or else not Is_Handle (Cur_C.Car)
                  then
                     return;
                  end if;
                  Fetch (H, To_Handle (Cur_C.Car), Bnd, Good);
                  if not Good or else Bnd.Kind /= Cell_Pair then
                     return;
                  end if;
                  Fetch (H, To_Handle (NV), NV_C, Good);
                  if not Good or else NV_C.Kind /= Cell_Pair then
                     return;
                  end if;
                  Init_Tmp := Bnd.Cdr;
                  Car_Of (H, Init_Tmp, Init, Good);
                  if not Good then
                     return;
                  end if;
                  Inst (H, Init, Vars, Ren, Path, Depth, False,
                        New_Init, Fuel - 1, Counter, Good);
                  if not Good then
                     return;
                  end if;
                  Cdr_Of (H, Bnd.Cdr, Pair_Rest, Good);
                  if not Good then
                     return;
                  end if;
                  if Is_Nil (Pair_Rest) then
                     Cons (H, New_Init, Nil_Value, Pair_Tail, Good);
                  else
                     if not Is_Handle (Pair_Rest) then
                        return;
                     end if;
                     Fetch (H, To_Handle (Pair_Rest), Bnd_Rest, Good);
                     if not Good or else Bnd_Rest.Kind /= Cell_Pair then
                        return;
                     end if;
                     Step := Bnd_Rest.Car;
                     Inst (H, Step, Vars, Vars_Env, Path, Depth, False,
                           New_Step, Fuel - 1, Counter, Good);
                     if not Good then
                        return;
                     end if;
                     Cons (H, New_Step, Nil_Value, Pair_Tail, Good);
                     if not Good then
                        return;
                     end if;
                     Cons (H, New_Init, Pair_Tail, Init_Tmp, Good);
                     Pair_Tail := Init_Tmp;
                  end if;
                  if not Good then
                     return;
                  end if;
                  Cons (H, NV_C.Car, Pair_Tail, Pair_Rest, Good);
                  if not Good then
                     return;
                  end if;
                  Cons (H, Pair_Rest, Acc, Tmp, Good);
                  if not Good then
                     return;
                  end if;
                  Acc := Tmp;
                  Cur := Cur_C.Cdr;
                  NV := NV_C.Cdr;
                  Left := Left - 1;
               end loop;
               Reverse_List (H, Acc, New_Binds, Good);
               if not Good then
                  return;
               end if;
            end;
            Inst (H, Test_Clause, Vars, Vars_Env, Path, Depth, False,
                  New_Clause, Fuel - 1, Counter, Good);
            if not Good then
               return;
            end if;
            Inst_Seq (H, Body_Forms, Vars, Vars_Env, Path, Depth,
                      New_Body, Fuel - 1, Counter, Good);
            if not Good then
               return;
            end if;
            Cons (H, New_Clause, New_Body, Tmp, Good);
            if not Good then
               return;
            end if;
            Cons (H, New_Binds, Tmp, Item, Good);
            if not Good then
               return;
            end if;
            Cons (H, Head, Item, Result, Good);
            Ok := Good;
            return;
         end;
      end if;

      --  define: the binder is renamed only when an enclosing body pre-scan
      --  put it in the rename environment (internal define).  A top-level
      --  define of a caller-visible name is left alone, while its formal
      --  parameters and body are still hygienic.
      if Head_Is and then Is_Symbol_Named (H, Head, "define") then
         declare
            Target : Value;
            Body_Forms   : Value;
            New_Target : Value;
            New_Body   : Value;
            Target_C   : Cell;
            Name       : Value;
            New_Name   : Value;
            New_Fls    : Value;
            Env_Body   : Value;
            Fls        : Value;
         begin
            Car_Of (H, Rest, Target, Good);
            if Good then
               Cdr_Of (H, Rest, Body_Forms, Good);
            end if;
            if not Good then
               return;
            end if;
            if Is_Handle (Target) then
               Fetch (H, To_Handle (Target), Target_C, Good);
               if not Good then
                  return;
               end if;
               if Target_C.Kind = Cell_Symbol then
                  Subst_Symbol (H, Target, Vars, Ren, Path, Depth,
                                False, New_Target, Good);
                  if not Good then
                     return;
                  end if;
                  Inst (H, Body_Forms, Vars, Ren, Path, Depth, False,
                        New_Body, Fuel - 1, Counter, Good);
                  if not Good then
                     return;
                  end if;
                  Cons (H, New_Target, New_Body, Tmp, Good);
                  if not Good then
                     return;
                  end if;
                  Cons (H, Head, Tmp, Result, Good);
                     Ok := Good;
                  return;
               elsif Target_C.Kind = Cell_Pair then
                  Name := Target_C.Car;
                  Fls := Target_C.Cdr;
                  if Is_Handle (Name) then
                     Subst_Symbol (H, Name, Vars, Ren, Path, Depth,
                                   False, New_Name, Good);
                     if not Good then
                        return;
                     end if;
                  else
                     New_Name := Name;
                  end if;
                  Inst_Formals (H, Fls, Vars, Ren, Path, Depth,
                                New_Fls, Env_Body, Fuel - 1, Counter, Good);
                  if not Good then
                     return;
                  end if;
                  Inst_Seq (H, Body_Forms, Vars, Env_Body, Path, Depth,
                            New_Body, Fuel - 1, Counter, Good);
                  if not Good then
                     return;
                  end if;
                  Cons (H, New_Name, New_Fls, New_Target, Good);
                  if not Good then
                     return;
                  end if;
                  Cons (H, New_Target, New_Body, Tmp, Good);
                  if not Good then
                     return;
                  end if;
                  Cons (H, Head, Tmp, Result, Good);
                     Ok := Good;
                  return;
               end if;
            end if;
         end;
      end if;

      --  Ordinary template list: instantiate car and cdr, then cons.
      Inst (H, C.Car, Vars, Ren, Path, Depth, No_Rename,
            New_Head, Fuel - 1, Counter, Good);
      if not Good then
         return;
      end if;
      Inst (H, C.Cdr, Vars, Ren, Path, Depth, No_Rename,
            New_Tail, Fuel - 1, Counter, Good);
      if not Good then
         return;
      end if;
      Cons (H, New_Head, New_Tail, Item, Good);
      if not Good then
         return;
      end if;
      Result := Item;
      Ok := True;
   end Inst;

   procedure Build
     (H      : in out Heap_Type;
      Spec   : Value;
      Result : out Value;
      Ok     : out Boolean)
   is
      Head  : Value;
      Lits  : Value;
      Rules : Value;
      Hd    : Handle;
      Good  : Boolean;
   begin
      Result := Nil_Value;
      Ok := False;
      Car_Of (H, Spec, Head, Good);
      if not Good or else not Is_Symbol_Named (H, Head, "syntax-rules") then
         return;
      end if;
      Cadr_Of (H, Spec, Lits, Good);
      if not Good then
         return;
      end if;
      Cddr_Of (H, Spec, Rules, Good);
      if not Good then
         return;
      end if;
      Allocate (H, Cell_Macro, Hd, Good);
      if not Good then
         return;
      end if;
      H.Cells (Hd.Index).Car := Lits;
      H.Cells (Hd.Index).Cdr := Rules;
      Result := From_Handle (Hd);
      Ok := True;
   end Build;

   procedure Expand
     (H      : in out Heap_Type;
      Macro  : Handle;
      Form   : Value;
      Result : out Value;
      Ok     : out Boolean)
   is
      MC     : Cell;
      Lits   : Value;
      Rules  : Value;
      Cur    : Value;
      Rule   : Value;
      Rest   : Value;
      Pat    : Value;
      Tmpl   : Value;
      Pat_Rest : Value;
      Form_Rest : Value;
      Vars   : Value;
      Good   : Boolean;
      Matched : Boolean;
      Left   : Natural := Max_List_Length + 1;
      Counter : Natural := 0;
      Path   : constant Path_Array := (others => 0);
   begin
      Result := Nil_Value;
      Ok := False;
      Fetch (H, Macro, MC, Good);
      if not Good or else MC.Kind /= Cell_Macro then
         return;
      end if;
      Lits := MC.Car;
      Rules := MC.Cdr;
      Cdr_Of (H, Form, Form_Rest, Good);
      if not Good then
         return;
      end if;
      Cur := Rules;
      while not Is_Nil (Cur) and then Left > 0 loop
         pragma Loop_Invariant (H.Ready);
         pragma Loop_Variant (Decreases => Left);
         if not Is_Handle (Cur) then
            return;
         end if;
         Car_Of (H, Cur, Rule, Good);
         if not Good or else not Is_Handle (Rule) then
            return;
         end if;
         Car_Of (H, Rule, Pat, Good);
         if not Good then
            return;
         end if;
         Cdr_Of (H, Rule, Rest, Good);
         if not Good then
            return;
         end if;
         Car_Of (H, Rest, Tmpl, Good);
         if not Good then
            return;
         end if;
         Cdr_Of (H, Pat, Pat_Rest, Good);
         if not Good then
            return;
         end if;
         Vars := Nil_Value;
         Match (H, Pat_Rest, Form_Rest, Lits, Vars, Macro_Fuel, Matched);
         if Matched then
            Inst (H, Tmpl, Vars, Nil_Value, Path, 0, False, Result,
                  Macro_Fuel, Counter, Ok);
            if Counter > Max_Fresh then
               Ok := False;
            end if;
            return;
         end if;
         declare
            Next : Value;
         begin
            Cdr_Of (H, Cur, Next, Good);
            if not Good then
               return;
            end if;
            Cur := Next;
            Left := Left - 1;
         end;
      end loop;
   end Expand;

end Tr7.Macros;
