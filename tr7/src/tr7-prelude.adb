package body Tr7.Prelude with
   SPARK_Mode => On
is

   --  The SRFI-1 procedures that must call user procedures are written in
   --  Scheme and evaluated by the machine on the first (import (srfi 1)).
   --  The n-ary forms (any, every, fold, fold-right, fold-left) walk all
   --  their lists in lockstep and stop at the first empty one, exactly as
   --  SRFI-1 specifies; the single-list shortcut avoids the per-element
   --  map/apply machinery when there is only one list.  delete and
   --  delete-duplicates compare with equal? (SRFI-1 uses the default
   --  equality), not eqv?.
   function Source return String is
     ("(define (filter p lst)"
      & " (if (null? lst) '()"
      & " (if (p (car lst))"
      & " (cons (car lst) (filter p (cdr lst)))"
      & " (filter p (cdr lst)))))"
      & "(define (fold kons knil . lists)"
      & " (if (null? lists) knil"
      & " (if (null? (cdr lists))"
      & " (let loop ((l (car lists)) (acc knil))"
      & " (if (null? l) acc (loop (cdr l) (kons (car l) acc))))"
      & " (let loop ((ls lists) (acc knil))"
      & " (if (any null? ls) acc"
      & " (loop (map cdr ls)"
      & " (apply kons (append (map car ls) (list acc)))))))))"
      & "(define (fold-right kons knil . lists)"
      & " (if (null? lists) knil"
      & " (if (null? (cdr lists))"
      & " (let loop ((l (car lists)))"
      & " (if (null? l) knil (kons (car l) (loop (cdr l)))))"
      & " (let loop ((ls lists))"
      & " (if (any null? ls) knil"
      & " (apply kons (append (map car ls)"
      & " (list (loop (map cdr ls))))))))))"
      & "(define (fold-left kons knil . lists)"
      & " (if (null? lists) knil"
      & " (if (null? (cdr lists))"
      & " (let loop ((l (car lists)) (acc knil))"
      & " (if (null? l) acc (loop (cdr l) (kons acc (car l)))))"
      & " (let loop ((ls lists) (acc knil))"
      & " (if (any null? ls) acc"
      & " (loop (map cdr ls) (apply kons (cons acc (map car ls)))))))))"
      & "(define (any pred . lists)"
      & " (if (null? lists) #f"
      & " (if (null? (cdr lists))"
      & " (let loop ((l (car lists)))"
      & " (if (null? l) #f"
      & " (let ((v (pred (car l)))) (if v v (loop (cdr l))))))"
      & " (let loop ((ls lists))"
      & " (if (any null? ls) #f"
      & " (let ((v (apply pred (map car ls))))"
      & " (if v v (loop (map cdr ls)))))))))"
      & "(define (every pred . lists)"
      & " (if (null? lists) #t"
      & " (if (null? (cdr lists))"
      & " (let loop ((l (car lists)))"
      & " (if (null? l) #t"
      & " (let ((v (pred (car l)))) (if v (loop (cdr l)) #f))))"
      & " (let loop ((ls lists) (prev #t))"
      & " (if (any null? ls) prev"
      & " (let ((v (apply pred (map car ls))))"
      & " (if v (loop (map cdr ls) v) #f)))))))"
      & "(define (find p lst)"
      & " (if (null? lst) #f (if (p (car lst)) (car lst) (find p (cdr lst)))))"
      & "(define (find-tail p lst)"
      & " (if (null? lst) #f (if (p (car lst)) lst (find-tail p (cdr lst)))))"
      & "(define (take lst n)"
      & " (if (= n 0) '() (cons (car lst) (take (cdr lst) (- n 1)))))"
      & "(define (drop lst n)"
      & " (if (= n 0) lst (drop (cdr lst) (- n 1))))"
      & "(define (take-while p lst)"
      & " (if (null? lst) '() (if (p (car lst))"
      & " (cons (car lst) (take-while p (cdr lst))) '())))"
      & "(define (drop-while p lst)"
      & " (if (null? lst) '() (if (p (car lst)) (drop-while p (cdr lst)) lst)))"
      & "(define (last lst) (car (last-pair lst)))"
      & "(define (iota n . rest)"
      & " (let ((start (if (null? rest) 0 (car rest)))"
      & " (step (if (or (null? rest) (null? (cdr rest))) 1 (cadr rest))))"
      & " (let loop ((i 0) (v start) (acc '()))"
      & " (if (= i n) (reverse acc) (loop (+ i 1) (+ v step) (cons v acc))))))"
      & "(define (zip . lists)"
      & " (if (null? lists) '()"
      & " (let loop ((ls lists) (acc '()))"
      & " (if (any null? ls) (reverse acc)"
      & " (loop (map cdr ls) (cons (map car ls) acc))))))"
      & "(define (concatenate lists) (apply append lists))"
      & "(define (append-map f . lists) (apply append (apply map (cons f lists))))"
      & "(define (delete x lst)"
      & " (filter (lambda (y) (not (equal? x y))) lst))"
      & "(define (delete-duplicates lst)"
      & " (if (null? lst) '()"
      & " (cons (car lst) (delete-duplicates (delete (car lst) (cdr lst))))))"
      & "(define (list-tabulate n f)"
      & " (let loop ((i 0) (acc '()))"
      & " (if (= i n) (reverse acc) (loop (+ i 1) (cons (f i) acc)))))");
end Tr7.Prelude;
