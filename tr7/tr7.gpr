with "config/tr7_config.gpr";
project Tr7 is

   for Library_Name use "Tr7";
   for Library_Version use Project'Library_Name & ".so." & Tr7_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Tr7_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("TR7_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   --  Runtime check level, shared by every project that withs this one:
   --  "on"  (default) compiles with -gnata so the test suites run with
   --        preconditions, postconditions and overflow checks live;
   --  "off" compiles with -gnatp, which is what benchmarks must use so that
   --        measurements are not dominated by contract checking.
   type Checks_Type is ("on", "off");
   Checks : Checks_Type := external ("TR7_CHECKS", "on");

   package Compiler is
      case Checks is
         when "on" =>
            for Default_Switches ("Ada") use
              Tr7_Config.Ada_Compiler_Switches &
              ("-gnat2012", "-gnata", "-gnatwa");
         when others =>
            for Default_Switches ("Ada") use
              Tr7_Config.Ada_Compiler_Switches &
              ("-gnat2012", "-gnatwa", "-gnatp");
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tr7;
