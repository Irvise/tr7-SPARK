with "config/tr7_c_config.gpr";
with "../tr7/tr7.gpr";
project Tr7_C is

   for Library_Name use "Tr7_C";
   for Library_Version use Project'Library_Name & ".so." & Tr7_C_Config.Crate_Version;

   for Languages use ("Ada", "C");

   for Source_Dirs use ("src/", "config/", "include/");
   for Object_Dir use "obj/" & Tr7_C_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("TR7_C_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Tr7_C_Config.Ada_Compiler_Switches & ("-gnat2012", "-gnata", "-gnatwa");
      for Default_Switches ("C") use ("-std=c11", "-Wall", "-Wextra");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tr7_C;
