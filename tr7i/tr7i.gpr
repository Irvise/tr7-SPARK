with "config/tr7i_config.gpr";
with "../tr7/tr7.gpr";
project Tr7i is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Tr7i_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tr7i.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Tr7i_Config.Ada_Compiler_Switches & ("-gnat2012", "-gnata", "-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tr7i;
